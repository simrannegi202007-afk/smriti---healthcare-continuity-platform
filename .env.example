# Smriti Environment Configuration
# Copy this file to server/.env or .env to configure local environment

PORT=5000
NODE_ENV=development
JWT_SECRET=smriti_healthcare_continuity_jwt_secret_2026
DB_PATH=./data/smriti.db
UPLOAD_DIR=./uploads
CLIENT_URL=http://localhost:3000

# Optional LLM API Key (Gemini or OpenAI API key per PRD Section 8).
# If left blank or if the API call fails/times out, Smriti's built-in cached
# sample explanation engine provides instant high-quality fallback explanations
# in English, Hindi, and Marathi with zero failure risk during demos.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
